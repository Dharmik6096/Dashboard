# DevOps Monitor V2 — copy to .env and replace every CHANGE_ME value
POSTGRES_DB=devops_monitor
POSTGRES_USER=devops_monitor
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_REDIS_PASSWORD

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=200

# Optional alert delivery
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_DEFAULT_RECIPIENT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional Stripe billing. Keep blank for Starter/self-hosted mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SCALE_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
